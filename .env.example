# Service account Google Cloud (punya akses ke Sheets API & Drive API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ID Google Spreadsheet yang dipakai sebagai database
# (ambil dari URL: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Opsional: ID folder Google Drive untuk upload lampiran (foto/kartu nama)
# Kosongkan jika belum ingin memakai fitur upload lampiran.
GOOGLE_DRIVE_FOLDER_ID=

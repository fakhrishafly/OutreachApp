# Service account Google Cloud (akses ke Sheets API)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ID Google Spreadsheet yang dipakai sebagai database
# (ambil dari URL: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Upload lampiran (foto dokumentasi/kartu nama) memakai Vercel Blob Storage.
# Tidak perlu token manual di sini — begitu Blob Store dibuat & di-connect ke
# project ini di Vercel, akses disediakan otomatis lewat OIDC saat runtime.
# Untuk development lokal, jalankan `vercel env pull .env.local` setelah
# project di-link ke Vercel (lihat SETUP.md).
